// The Transport panel: where the player is, in the device's time, and the commands that
// move it. Its values are transport.lua's model, written by ui_dev from player.transport;
// its presses and its bar go out as events that ui_dev turns into the player's commands.

use "krome/std"
use "ui_dev/widgets"

def transport-panel {
    col [dev-panel] id=transport w=fill {
        row gap=8 middle w=fill {
            text "Transport" [dev-title]
            text "{t_state}" id=t_state [dev-value] w=64
            text "{t_row}" id=t_row [dev-title]
            box w=fill clip {
                text "{t_title}" id=t_title [dev-value] nowrap
            }
            text "{t_seeking}" id=t_seeking [dev-title]
            text "{t_pos} / {t_len}" id=t_time [dev-value] w=110 right
        }
        row gap=6 middle w=fill {
            dev-btn "Prev" id=previous -> previous key="mod+up" tooltip="the row before (Ctrl+Up)"
            dev-btn "Play" id=play -> play tooltip="play, or on from a pause"
            dev-btn "Pause" id=pause -> pause tooltip="hold the playhead"
            dev-btn "Stop" id=stop -> stop key="mod+s" tooltip="stop (Ctrl+S)"
            dev-btn "Next" id=next -> next key="mod+down" tooltip="the row after (Ctrl+Down)"
            dev-btn "-10 s" id=back -> back key="mod+left" tooltip="ten seconds back (Ctrl+Left)"
            dev-btn "+10 s" id=on -> on key="mod+right" tooltip="ten seconds on (Ctrl+Right)"
            dev-slider id=seek @t_bar w=fill
            // Space plays and pauses, from anywhere but an edit: a control of its own, of no size.
            hit id=toggle -> toggle key="space" nofocus w=0 h=0
        }
    }
}

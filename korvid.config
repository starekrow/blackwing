-- Blackwing builds against the Korvid engine checked out beside it (~/code/korvid next to
-- ~/code/blackwing). Its modules are the directories under modules/; its outputs go in
-- build/ and dist/ here, and nothing is written into the engine's tree.
engine "../korvid"
requires_kormake "1.2" -- codegen_sources (hifi_codec)
modulepath { "modules" }
target "linux-dev"
